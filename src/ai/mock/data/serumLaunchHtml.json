"<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>秋季精华首发 · 作战总览</title>\n  <style>\n    :root{--paper:#f7f5ef;--ink:#243c33;--muted:#68736d;--line:#dcded5;--amber:#a16e36;--soft:#eee9de;--green:#dfe9df}\n    *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:14px/1.75 -apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",sans-serif}main{max-width:1160px;margin:auto;padding:36px 40px 28px}h1,h2,h3,p{margin:0}h1{font-size:clamp(32px,5.6vw,64px);line-height:1.14;letter-spacing:-2px;font-weight:600}h2{font-size:25px;letter-spacing:-.7px;line-height:1.35}h3{font-size:16px;line-height:1.45}.eyebrow{font-size:11px;letter-spacing:2px;text-transform:uppercase}.muted{color:var(--muted)}.masthead{display:flex;justify-content:space-between;align-items:center;padding-bottom:20px;border-bottom:1px solid var(--line);gap:20px}.masthead strong{font-weight:500;letter-spacing:1px}.stamp{font-size:11px;border:1px solid var(--line);padding:3px 10px;border-radius:20px;white-space:nowrap}.hero{display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:center;margin:30px 0}.hero-copy{padding:22px 0}.hero .eyebrow{color:var(--amber);margin-bottom:19px}.hero p{max-width:410px;margin-top:22px;font-size:15px;color:var(--muted)}.hero-image{width:100%;aspect-ratio:1.2;object-fit:cover;object-position:66% center;border-radius:2px}.hero-meta{display:flex;flex-wrap:wrap;gap:18px;margin-top:26px;padding-top:17px;border-top:1px solid var(--line);font-size:12px}.hero-meta strong{display:block;font-size:15px;color:var(--ink)}.decision{display:grid;grid-template-columns:120px 1fr;gap:24px;background:var(--ink);color:#fff;padding:24px 28px}.decision .eyebrow{color:#c6d3c5}.decision strong{font-size:17px;font-weight:500}.decision p{font-size:13px;color:#d4ddd4;margin-top:6px}.facts{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line);padding:28px 0;margin-bottom:36px}.fact{padding:0 20px;border-left:1px solid var(--line)}.fact:first-child{border:0;padding-left:0}.fact .value{font-size:32px;letter-spacing:-1px;line-height:1.35;font-weight:500}.fact small{color:var(--muted);font-size:11px}.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin:34px 0 20px}.section-head p{max-width:440px;font-size:12px;color:var(--muted);text-align:right}.section-head .eyebrow{color:var(--amber);margin-bottom:7px}.two-col{display:grid;grid-template-columns:1.1fr 1fr;gap:32px}.timeline{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-top:1px solid var(--ink);padding-top:19px}.phase{padding:0 17px;border-left:1px solid var(--line)}.phase:first-child{padding-left:0;border:0}.phase time{font-size:12px;color:var(--amber)}.phase h3{margin:10px 0 8px}.phase p{font-size:12px;color:var(--muted)}.phase .owner{font-size:11px;margin-top:14px;color:var(--ink)}.panel{border:1px solid var(--line);padding:23px 25px;background:#faf9f5}.panel h3{margin-bottom:18px}.budget-row{margin-bottom:20px}.budget-row:last-child{margin-bottom:0}.budget-row header{display:flex;justify-content:space-between;font-size:12px;gap:12px}.track{height:7px;background:var(--soft);margin:8px 0}.bar{height:100%;background:var(--ink)}.budget-row small{display:block;font-size:11px;color:var(--muted)}.chips{display:flex;gap:8px;flex-wrap:wrap}.chip{font-size:11px;padding:2px 8px;border-radius:12px;background:var(--green);color:#3a6348}.chip.wait{background:#f2e7d4;color:#94632f}.chip.check{background:#edece7;color:#6a7169}table{border-collapse:collapse;width:100%;font-size:12px}th{font-weight:500;color:var(--muted);text-align:left;background:#eceee6}th,td{padding:11px 12px;border-bottom:1px solid var(--line);vertical-align:top}td strong{font-weight:500}td:last-child,th:last-child{padding-right:0}.table-wrap{overflow:auto}.table-wrap table{min-width:580px}.stock{display:flex;height:20px;margin:17px 0 14px;overflow:hidden}.stock span:nth-child(1){background:#304d3e;width:41.6667%}.stock span:nth-child(2){background:#719079;width:37.5%}.stock span:nth-child(3){background:#bdb393;width:20.8333%}.legend{display:grid;gap:9px;font-size:12px}.legend-row{display:flex;justify-content:space-between;align-items:center}.dot{width:8px;height:8px;display:inline-block;margin-right:8px}.footnote{margin-top:14px;font-size:11px;color:var(--muted)}.gate-list{list-style:none;padding:0;margin:0}.gate{display:grid;grid-template-columns:26px 1fr auto;gap:12px;padding:15px 0;border-bottom:1px solid var(--line)}.gate:last-child{border:0}.gate-number{font-size:12px;color:var(--amber)}.gate h3{font-size:13px}.gate p{font-size:12px;color:var(--muted);margin-top:3px}.gate .chip{align-self:start;white-space:nowrap}.risk-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.risk{border-top:2px solid var(--amber);padding:16px 0 4px}.risk .label{font-size:10px;letter-spacing:1px;color:var(--amber)}.risk h3{margin:9px 0}.risk p{font-size:12px;color:var(--muted)}.risk .response{border-top:1px solid var(--line);padding-top:12px;margin-top:14px;color:var(--ink)}.data-note{display:flex;align-items:flex-start;gap:20px;margin-top:30px;padding:21px 25px;background:var(--soft)}.data-note h3{font-size:14px;min-width:92px}.data-note p{font-size:12px;color:var(--muted)}.asset-list{display:grid;grid-template-columns:repeat(3,1fr);gap:0 25px}.asset{display:flex;gap:14px;padding:19px 0;border-top:1px solid var(--line)}.extension{font-family:ui-monospace,SFMono-Regular,monospace;font-size:10px;border:1px solid var(--line);min-width:45px;height:27px;text-align:center;line-height:25px;margin-top:2px;background:#fdfcf8}.asset h3{font-size:13px}.asset p{font-size:11px;color:var(--muted);margin-top:5px}.footer{margin-top:32px;border-top:1px solid var(--line);padding-top:16px;display:flex;justify-content:space-between;gap:20px;font-size:10px;color:var(--muted)}\n    @media(max-width:720px){main{padding:22px 22px}.hero{grid-template-columns:1fr;gap:0;margin:12px 0 24px}.hero-copy{padding:18px 0 24px}h1{letter-spacing:-1px}.hero p{max-width:none}.hero-image{aspect-ratio:1.6;object-position:center}.decision{grid-template-columns:1fr;gap:8px;padding:22px}.facts{grid-template-columns:repeat(2,1fr);gap:20px 0;padding:24px 0}.fact:nth-child(3){border:0;padding-left:0}.fact .value{font-size:28px}.section-head{display:block}.section-head p{text-align:left;margin-top:10px}.two-col{grid-template-columns:1fr;gap:18px}.timeline{grid-template-columns:repeat(2,1fr);row-gap:26px}.phase:nth-child(3){padding-left:0;border:0}.risk-grid{grid-template-columns:1fr;gap:10px}.asset-list{grid-template-columns:1fr 1fr}.data-note{display:block;padding:20px}.data-note p{margin-top:8px}.gate{grid-template-columns:20px 1fr}.gate .chip{grid-column:2;justify-self:start}.footer{display:block}.footer span{display:block;margin-bottom:4px}.panel{padding:20px}.masthead .eyebrow{letter-spacing:1px;font-size:10px}}\n    @media print{body{font-size:11px}main{max-width:none;padding:0}.hero-image{max-height:230px}.hero{gap:28px;margin:22px 0}h1{font-size:40px}.section-head{margin:24px 0 15px}.panel,.risk,.asset,.gate{break-inside:avoid}.decision,th,.stock span,.bar{-webkit-print-color-adjust:exact;print-color-adjust:exact}.facts{margin-bottom:20px}.footer{margin-top:20px}}\n  </style>\n</head>\n<body>\n<main>\n  <header class=\"masthead\"><strong class=\"eyebrow\">AUTUMN / LAUNCH OPERATIONS</strong><span class=\"stamp\">内部计划 · 合成演示数据</span></header>\n  <section class=\"hero\" aria-labelledby=\"launch-title\">\n    <div class=\"hero-copy\"><div class=\"eyebrow\">SEPTEMBER 2026 · WORKING PLAN V1.0</div><h1 id=\"launch-title\">秋季精华首发<br>把每一步，<br>连成闭环。</h1><p>围绕同一 SKU、同一内容版本和同一数据口径，连接达人、内容、商品与增长。先核对上线条件，再释放阶段预算。</p><div class=\"hero-meta\"><div><span class=\"muted\">计划首发窗口</span><strong>09.10 — 09.18</strong></div><div><span class=\"muted\">项目负责人</span><strong>周岚</strong></div><div><span class=\"muted\">商品规格</span><strong>精华 · 30 ml</strong></div></div></div>\n    <img class=\"hero-image\" src=\"/task-assets/serum-launch/serum-launch-hero.png\" alt=\"秋日暖光中的琥珀色精华瓶，置于洞石台面；虚构商品主视觉\">\n  </section>\n  <aside class=\"decision\"><div class=\"eyebrow\">当前推进判断</div><div><strong>准备工作继续；上线与放量仍受门禁约束。</strong><p>8 位核心达人已有 6 位确认，2 位待回签。库存、报价及文案需按同一版本复核；本页展示计划情景，新增文件不代表任务已完成。</p></div></aside>\n  <section class=\"facts\" aria-label=\"首发计划参数\"><div class=\"fact\"><p class=\"muted\">计划到手价</p><p class=\"value\">¥299</p><small>单件 30 ml / 各渠道同口径</small></div><div class=\"fact\"><p class=\"muted\">首批库存</p><p class=\"value\">12,000</p><small>件 / 含三渠道分配</small></div><div class=\"fact\"><p class=\"muted\">投流预算上限</p><p class=\"value\">¥300,000</p><small>分阶段释放 / 追加需确认</small></div><div class=\"fact\"><p class=\"muted\">核心达人确认</p><p class=\"value\">6 / 8</p><small>2 份回签待收口 / 不视为完成</small></div></section>\n  <div class=\"section-head\"><div><div class=\"eyebrow\">01 / CAMPAIGN RHYTHM</div><h2>节奏先对齐，预算再跟进。</h2></div><p>各阶段都有独立退出条件。任何范围变化需形成新版本；前一阶段的问题不通过放量掩盖。</p></div>\n  <section class=\"timeline\" aria-label=\"首发阶段计划\"><article class=\"phase\"><time>09.01 — 09.09</time><h3>准备与冻结</h3><p>收口两份回签，锁定 SKU、脚本、价格库存与归因编码；完成主备直播彩排。</p><p class=\"owner\">陈默 / 林洁 / 梁川</p></article><article class=\"phase\"><time>09.10 — 09.11</time><h3>首发冷启</h3><p>以小批素材验证链路、受众和订单回传。库存及宣称校验通过后启动首场。</p><p class=\"owner\">高远 / 许宁 / 韩序</p></article><article class=\"phase\"><time>09.12 — 09.16</time><h3>验证后放量</h3><p>按有效样本与退款口径逐日复核，仅对已通过审核且库存充足的素材增加预算。</p><p class=\"owner\">许宁 / 苏禾 / 梁川</p></article><article class=\"phase\"><time>09.17 — 09.18</time><h3>追投与复盘</h3><p>核对库存后追投，按渠道、达人及素材结算；保存数据快照、差异与后续责任。</p><p class=\"owner\">韩序 / 周岚</p></article></section>\n  <div class=\"section-head\"><div><div class=\"eyebrow\">02 / RESOURCE ALLOCATION</div><h2>预算与库存，用一套边界。</h2></div><p>计划上限不是实际消耗，分配库存不是实际成交。实际回传前，结果指标保留未采集状态。</p></div>\n  <section class=\"two-col\"><div class=\"panel\"><h3>分阶段投流预算</h3><div class=\"budget-row\"><header><strong>冷启 / 20%</strong><span>¥60,000</span></header><div class=\"track\"><div class=\"bar\" style=\"width:20%\"></div></div><small>触发：内容、SKU 与链路门禁通过；先验证小样本。</small></div><div class=\"budget-row\"><header><strong>放量 / 60%</strong><span>¥180,000</span></header><div class=\"track\"><div class=\"bar\" style=\"width:60%;background:#719079\"></div></div><small>触发：有效样本与订单回传可核对，达到已核准阶段门槛。</small></div><div class=\"budget-row\"><header><strong>追投 / 20%</strong><span>¥60,000</span></header><div class=\"track\"><div class=\"bar\" style=\"width:20%;background:#a89165\"></div></div><small>触发：退款口径与库存复核完成，负责人确认继续。</small></div><p class=\"footnote\">许宁执行；周岚确认追加与例外。ROI 门槛见预算表的计划条件，不作为自动放行凭据。</p></div><div class=\"panel\"><h3>首批库存渠道分配</h3><p class=\"muted\" style=\"font-size:12px\">总量 12,000 件 · 到手价均为 ¥299</p><div class=\"stock\" role=\"img\" aria-label=\"自播5000件、达人直播4500件、短视频2500件\"><span></span><span></span><span></span></div><div class=\"legend\"><div class=\"legend-row\"><span><i class=\"dot\" style=\"background:#304d3e\"></i>自播</span><strong>5,000 件 · 41.7%</strong></div><div class=\"legend-row\"><span><i class=\"dot\" style=\"background:#719079\"></i>达人直播</span><strong>4,500 件 · 37.5%</strong></div><div class=\"legend-row\"><span><i class=\"dot\" style=\"background:#bdb393\"></i>短视频</span><strong>2,500 件 · 20.8%</strong></div></div><p class=\"footnote\">梁川负责库存与价格核对。渠道调拨要更新库存版本；赠品、平台券与运费条件随版本一起检查，禁止靠跨渠道挪用掩盖缺口。</p><div class=\"chips\" style=\"margin-top:19px\"><span class=\"chip check\">商品版本待最终核对</span><span class=\"chip check\">实际售出：未采集</span></div></div></section>\n  <div class=\"section-head\"><div><div class=\"eyebrow\">03 / RELEASE GATES</div><h2>四道门禁，逐项留证据。</h2></div><p>每道门禁需要明确的文件版本、核对人和结论。沟通记录不自动等于审批通过。</p></div>\n  <ol class=\"gate-list\"><li class=\"gate\"><span class=\"gate-number\">01</span><div><h3>达人与档期一致</h3><p>陈默：8 位核心达人合同、发布时段、素材授权和替补顺序一一对应；收口两份回签后再冻结档期。</p></div><span class=\"chip wait\">2 份回签待收口</span></li><li class=\"gate\"><span class=\"gate-number\">02</span><div><h3>宣称与内容逐条匹配</h3><p>苏禾 / 林洁：字幕、口播、详情页及达人改写均引用已审核证据矩阵；不加入未经证实的临床数据或医疗承诺。</p></div><span class=\"chip check\">发布前复核</span></li><li class=\"gate\"><span class=\"gate-number\">03</span><div><h3>交易与主备链路可执行</h3><p>高远 / 梁川：彩排核对价格、库存、赠品、上下架与断流切换；异常发生时停止入口并保存现场记录。</p></div><span class=\"chip check\">待彩排签收</span></li><li class=\"gate\"><span class=\"gate-number\">04</span><div><h3>投放与归因口径共用</h3><p>许宁 / 韩序：渠道、达人和素材编码贯通；区分实时成交、延迟归因、退款与净成交，不把缺失数据回填为零。</p></div><span class=\"chip check\">待数据链路核对</span></li></ol>\n  <div class=\"section-head\"><div><div class=\"eyebrow\">04 / TEAM HANDOFF</div><h2>动作有负责人，交接有版本。</h2></div><p>Owner 汇总结果与决定；各专业负责人保留原始证据。当前页面只是首发协作计划。</p></div>\n  <div class=\"table-wrap\"><table><thead><tr><th>责任域</th><th>负责人</th><th>本轮具体产出</th><th>接收与核对</th></tr></thead><tbody><tr><td>项目决策</td><td>周岚</td><td>首发范围、预算上限、例外决定与复盘行动表</td><td>逐项核对门禁后决定上线</td></tr><tr><td>达人商务</td><td>陈默</td><td>8 位核心达人合同附件、档期与替补顺序</td><td>高远核对执行时段，苏禾核对授权</td></tr><tr><td>内容制作</td><td>林洁</td><td>3 类脚本、镜头清单、字幕及可替换段</td><td>苏禾逐项审核，高远接收直播母版</td></tr><tr><td>直播执行</td><td>高远</td><td>主备链路彩排记录、逐分钟执行表与异常切换</td><td>梁川核对商品配置，周岚收口问题</td></tr><tr><td>商品与履约</td><td>梁川</td><td>价格、12,000 件库存分配及渠道更新日志</td><td>许宁投放前核对可售量</td></tr><tr><td>投流增长</td><td>许宁</td><td>三阶段预算表、素材批次及停止记录</td><td>韩序复核口径，周岚确认阶段决策</td></tr><tr><td>数据归因</td><td>韩序</td><td>渠道 CSV、指标字典、退款与延迟归因差异表</td><td>周岚接收复盘结论与行动</td></tr><tr><td>内容审核</td><td>苏禾</td><td>宣称矩阵、授权边界与风险关闭记录</td><td>林洁和高远仅使用已核对版本</td></tr></tbody></table></div>\n  <div class=\"section-head\"><div><div class=\"eyebrow\">05 / EXCEPTION RESPONSE</div><h2>异常先止住，再恢复。</h2></div><p>先暂停受影响的环节，保留其他已核对范围；恢复需要明确责任人的核对结论。</p></div>\n  <section class=\"risk-grid\"><article class=\"risk\"><span class=\"label\">CREATOR / SCHEDULE</span><h3>核心达人回签延迟</h3><p>截止前未收到有效回签，不把口头确认计入已锁定档期，不把暂定曝光纳入确定性结果。</p><p class=\"response\">陈默启用替补顺序；高远重排相邻时段；周岚确认范围变化并保存新版本。</p></article><article class=\"risk\"><span class=\"label\">COMMERCE / STOCK</span><h3>库存或价格发生偏差</h3><p>商品后台与已冻结版本不符时，暂停相关商品入口与投放，现场保存配置及订单时间点。</p><p class=\"response\">梁川核对可售量与价格；高远校正口播；许宁仅在库存恢复后重启相关素材。</p></article><article class=\"risk\"><span class=\"label\">CONTENT / DATA</span><h3>宣称越界或归因缺失</h3><p>风险表述立即撤回并暂停素材；数据延迟显示未采集，不能以零值推动预算判断。</p><p class=\"response\">苏禾审核新内容；韩序核对回传；周岚确认恢复条件，原错误版本保留追溯。</p></article></section>\n  <aside class=\"data-note\"><h3>指标口径</h3><p>支付 GMV 按去重订单支付金额统计；退款与取消单单独记录；净成交 = 支付 GMV − 退款。投放 ROI 需注明归因窗口、付费归因金额及消耗。所有预测与计划均与实际数据分列。本素材包中的渠道 CSV 是日期 × 渠道的<strong>计划分配</strong>，不代表订单结果。</p></aside>\n  <div class=\"section-head\"><div><div class=\"eyebrow\">06 / DELIVERY LIBRARY</div><h2>六种文件，六种使用方式。</h2></div><p>在任务“文件”中打开对应附件。保留各自原格式，便于继续编辑、分析与交接。</p></div>\n  <section class=\"asset-list\"><article class=\"asset\"><span class=\"extension\">HTML</span><div><h3>首发作战总览</h3><p>阶段节奏、资源、门禁与责任的完整阅读页。</p></div></article><article class=\"asset\"><span class=\"extension\">XLSX</span><div><h3>预算与库存工作簿</h3><p>多张工作表、公式、分配比例、风险门禁与指标字典。</p></div></article><article class=\"asset\"><span class=\"extension\">CSV</span><div><h3>渠道计划明细</h3><p>按日期和渠道拆分的结构化分配，可直接导入分析工具。</p></div></article><article class=\"asset\"><span class=\"extension\">PDF</span><div><h3>首发执行手册</h3><p>上线清单、角色分工、异常 SOP 和复盘口径。</p></div></article><article class=\"asset\"><span class=\"extension\">DOCX</span><div><h3>内容与直播简报</h3><p>受众策略、短视频脚本、镜头与直播执行表。</p></div></article><article class=\"asset\"><span class=\"extension\">PNG</span><div><h3>秋季精华主视觉</h3><p>琥珀玻璃、暖秋光线与洞石质感的虚构商品视觉。</p></div></article></section>\n  <footer class=\"footer\"><span>秋季抗老精华首发闭环 / 内部协作计划 V1.0</span><span>合成演示数据 · 快照 2026-09-01 · 不作为业务审批或功效证明</span></footer>\n</main>\n</body>\n</html>\n"
