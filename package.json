{
  "name": "agentdoor-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:toast",
    "build:toast": "node scripts/build-shared-toast.mjs",
    "prebuild": "npm run build:toast",
    "test": "tsx --test server/*.test.ts",
    "test:lab": "node --import tsx --test server/testLabStore.test.ts server/testLabRunner.test.ts server/testLabComparison.test.ts server/testLabCategories.test.ts server/testLabSkillPackage.test.ts server/testLabFreshCreation.test.ts server/testLabRunCenter.test.ts server/testLabHttp.test.ts server/testLabValidation.test.ts server/testLabUi.test.ts server/testLabManagement.test.ts server/testLabMarkdown.test.ts server/testLabSkillBundles.test.ts server/testLabScenarioCatalog.test.ts server/testLabWorkflows.test.ts server/testLabWorkflowReports.test.mjs",
    "build": "tsc -b && vite build",
    "design:check": "node scripts/design-check.mjs",
    "build:mcp": "vite build --config mcp/vite.config.ts && tsc -p mcp/tsconfig.json",
    "mcp": "node dist-mcp/server.js --stdio",
    "mcp:http": "node dist-mcp/server.js --http",
    "preview": "vite preview",
    "typecheck:lab": "tsc -p tsconfig.test-lab.json",
    "lab:workflow": "node scripts/run-test-lab-workflow.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@lexical/code": "0.50.0",
    "@lexical/link": "0.50.0",
    "@lexical/list": "0.50.0",
    "@lexical/mark": "0.50.0",
    "@lexical/markdown": "0.50.0",
    "@lexical/react": "0.50.0",
    "@lexical/rich-text": "0.50.0",
    "@lobehub/icons": "^5.16.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@tigerabrodioss/fude": "^0.1.4",
    "@vitejs/plugin-react": "latest",
    "ajv": "^8.20.0",
    "avvvatars-react": "^0.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "lexical": "0.50.0",
    "lucide-react": "latest",
    "motion": "^13.1.1",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tsx": "^4.23.12",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
