{
  "name": "agentdoor-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "design:check": "node scripts/design-check.mjs",
    "verify": "npm run design:check && npm run build",
    "build:mcp": "vite build --config mcp/vite.config.ts && tsc -p mcp/tsconfig.json",
    "mcp": "node dist-mcp/server.js --stdio",
    "mcp:http": "node dist-mcp/server.js --http",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@lobehub/icons": "^5.16.0",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-tabs": "^1.1.21",
    "@svar-ui/react-gantt": "^2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tigerabrodioss/fude": "^0.1.4",
    "@vitejs/plugin-react": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "motion": "^13.1.1",
    "react": "latest",
    "react-dom": "latest",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "latest",
    "vite": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
