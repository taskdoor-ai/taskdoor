{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskdoor.local/schemas/subtask-suggestions.v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "taskdoor.subtask-suggestions.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "parentTaskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": [
        "ready",
        "partial",
        "needs_clarification",
        "no_split_needed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "suggestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suggestion"
      },
      "maxItems": 100
    },
    "coveredByExisting": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "taskId",
          "reason"
        ]
      },
      "uniqueItems": true
    },
    "contextGaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "maxItems": 3
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "parentTaskId",
    "status",
    "summary",
    "suggestions",
    "coveredByExisting",
    "contextGaps",
    "questions",
    "warnings"
  ],
  "$defs": {
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 1,
          "maxItems": 50
        },
        "ownerMemberId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "assignmentReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "memberId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "contribution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "memberId",
              "contribution"
            ]
          },
          "maxItems": 100
        },
        "dueDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "executionTips": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "effortEstimate": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "workMethod": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                }
              },
              "required": [
                "minutes",
                "workMethod",
                "reason"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "clientId",
        "title",
        "goal",
        "acceptanceCriteria",
        "ownerMemberId",
        "assignmentReason",
        "participants",
        "dueDate",
        "executionTips",
        "effortEstimate",
        "rationale",
        "sourceRefs"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 2,
          "maxItems": 4,
          "uniqueItems": true
        },
        "recommended": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "allowCustom": {
          "const": true
        },
        "placeholder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "question",
        "choices",
        "recommended",
        "allowCustom",
        "placeholder"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "suggestions": {
            "minItems": 1
          },
          "questions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "contextGaps": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_clarification"
          }
        }
      },
      "then": {
        "properties": {
          "questions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "no_split_needed"
          }
        }
      },
      "then": {
        "properties": {
          "suggestions": {
            "maxItems": 0
          },
          "questions": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
