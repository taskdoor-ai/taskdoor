{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskdoor.com/schemas/task-preview-v1.json",
  "title": "TaskDoor task preview v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "status",
    "summary",
    "tasks",
    "questions",
    "warnings",
    "duplicates",
    "parentCandidates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "taskdoor.task-preview.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "enum": [
        "ready",
        "needs_clarification"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 4000
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/task"
      },
      "maxItems": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "choices",
          "recommended",
          "allowCustom",
          "placeholder"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 2,
            "maxItems": 4,
            "uniqueItems": true
          },
          "recommended": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "allowCustom": {
            "const": true
          },
          "placeholder": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "maxItems": 3
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "maxItems": 100
    },
    "duplicates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "relationship",
          "reason"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "relationship": {
            "enum": [
              "same_outcome",
              "overlap",
              "possible"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "title": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "parentCandidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "reason"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "title": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientId",
        "title",
        "goal",
        "acceptanceCriteria",
        "ownerMemberId",
        "assignmentReason",
        "participants",
        "dueDate",
        "executionTips",
        "effortEstimate",
        "children"
      ],
      "properties": {
        "clientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "maxItems": 100,
          "minItems": 1
        },
        "ownerMemberId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "assignmentReason": {
          "type": "string",
          "maxLength": 4000
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "memberId",
              "contribution"
            ],
            "properties": {
              "memberId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "contribution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000
              }
            }
          },
          "maxItems": 100
        },
        "dueDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "executionTips": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "maxItems": 100
        },
        "effortEstimate": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minutes",
                "workMethod",
                "reason"
              ],
              "properties": {
                "minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "workMethod": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                }
              }
            }
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          },
          "maxItems": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "tasks": {
            "minItems": 1
          },
          "questions": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_clarification"
          }
        }
      },
      "then": {
        "properties": {
          "questions": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
