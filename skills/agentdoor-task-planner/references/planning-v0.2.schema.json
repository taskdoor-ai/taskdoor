{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentDoor contextual task planning v0.2 (proposal only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "baseSnapshotId",
    "baseRevision",
    "baseTaskVersions",
    "intent",
    "disposition",
    "summary",
    "reasoningSummary",
    "proposal",
    "duplicateCheck",
    "questions",
    "warnings",
    "nextActions",
    "externalEffects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agentdoor.task-plan.v0.2"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "baseSnapshotId": {
      "type": "string",
      "minLength": 1
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0
    },
    "baseTaskVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "intent": {
      "enum": [
        "create",
        "refine",
        "replan",
        "next_batch",
        "query",
        "unclear"
      ]
    },
    "disposition": {
      "enum": [
        "ready_for_confirmation",
        "needs_clarification",
        "route_required",
        "no_change"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "reasoningSummary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidenceRefs"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "$ref": "#/$defs/refs"
          }
        }
      },
      "maxItems": 4
    },
    "proposal": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/proposal"
        }
      ]
    },
    "duplicateCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scopeTeamIds",
        "assessments",
        "coverageNote"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_checked",
            "completed",
            "partial",
            "unavailable"
          ]
        },
        "scopeTeamIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "assessments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "taskId",
              "relationship",
              "reason",
              "evidenceRefs"
            ],
            "properties": {
              "taskId": {
                "type": "string",
                "minLength": 1
              },
              "relationship": {
                "enum": [
                  "same_outcome",
                  "overlap",
                  "different_instance",
                  "possible",
                  "template_only"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidenceRefs": {
                "$ref": "#/$defs/refs"
              },
              "resolution": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "newScope", "changeIds", "evidenceRefs"],
                "properties": {
                  "kind": {"const": "propose_uncovered_scope"},
                  "newScope": {"type": "string", "minLength": 1},
                  "changeIds": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1},
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "evidenceRefs": {"$ref": "#/$defs/refs"}
                }
              }
            }
          }
        },
        "coverageNote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "question",
          "blocking"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        }
      },
      "maxItems": 2
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "taskId",
          "label"
        ],
        "properties": {
          "action": {
            "enum": [
              "ask_user",
              "open_task",
              "retry_context",
              "review_proposal"
            ]
          },
          "taskId": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "maxItems": 4
    },
    "externalEffects": {
      "const": "none"
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "date": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date"
        }
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "basis",
            "evidenceRefs"
          ],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "basis": {
              "enum": [
                "explicit",
                "inferred",
                "confirmed"
              ]
            },
            "evidenceRefs": {
              "$ref": "#/$defs/refs"
            }
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "tips": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ownerRecommendation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "memberId",
            "basis",
            "reason",
            "evidenceRefs"
          ],
          "properties": {
            "memberId": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "basis": {
              "enum": [
                "explicit",
                "recommended",
                "unassigned"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "evidenceRefs": {
              "$ref": "#/$defs/refs"
            }
          }
        },
        "participantRecommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "memberId",
              "contribution",
              "evidenceRefs"
            ],
            "properties": {
              "memberId": {
                "type": "string",
                "minLength": 1
              },
              "contribution": {
                "type": "string",
                "minLength": 1
              },
              "evidenceRefs": {
                "$ref": "#/$defs/refs"
              }
            }
          }
        },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startOn",
            "dueOn",
            "basis",
            "assumptions",
            "evidenceRefs"
          ],
          "properties": {
            "startOn": {
              "$ref": "#/$defs/date"
            },
            "dueOn": {
              "$ref": "#/$defs/date"
            },
            "basis": {
              "enum": [
                "explicit",
                "recommended",
                "unknown"
              ]
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidenceRefs": {
              "$ref": "#/$defs/refs"
            }
          }
        },
        "estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ewdHours",
            "basis",
            "assumptions",
            "evidenceRefs"
          ],
          "properties": {
            "ewdHours": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "basis": {
              "enum": [
                "model",
                "history",
                "unknown"
              ]
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidenceRefs": {
              "$ref": "#/$defs/refs"
            }
          }
        },
        "dependsOnTaskIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "minProperties": 1
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "targetId",
        "parentId",
        "fields",
        "reason",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "create",
            "update"
          ]
        },
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "fields": {
          "$ref": "#/$defs/fields"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRefs": {
          "$ref": "#/$defs/refs"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootTaskId",
        "complexity",
        "changes",
        "preservedTaskIds"
      ],
      "properties": {
        "rootTaskId": {
          "type": "string",
          "minLength": 1
        },
        "complexity": {
          "enum": [
            "simple",
            "complex",
            "undetermined"
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          },
          "minItems": 1
        },
        "preservedTaskIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
