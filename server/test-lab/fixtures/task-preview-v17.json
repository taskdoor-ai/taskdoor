        "acceptanceCriteria": [
          "介绍文案包含用途和已确认的核心卖点",
          "海报源文件与导出图齐全"
        ],
        "ownerMemberId": "member-lead",
        "assignmentReason": "输入职责中承担整体交付统筹",
        "participants": [],
        "dueDate": null,
        "executionTips": [],
        "effortEstimate": null,
        "children": [
          {
