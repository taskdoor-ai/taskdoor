            "acceptanceCriteria": [
              "使用已确认的卖点文案",
              "交付可编辑源文件和导出图"
            ],
            "ownerMemberId": "member-designer",
            "assignmentReason": "输入职责覆盖视觉设计",
            "participants": [],
            "dueDate": null,
            "executionTips": [],
            "effortEstimate": {
              "minutes": 120,
              "workMethod": "使用已确认资料与常用制作工具，人工制作并核验交付",
              "reason": "示例估算假设：资料齐全，制作与修改约90分钟、最终核验约30分钟；不含等待。"
            },
            "children": []
          }
        ]
      }
    ],
    "questions": [],
    "warnings": [],
    "duplicates": [],
    "parentCandidates": []
  }
}
